«func:Write-Host» «str:"Hello »«var:$name»«str:, you have »«var:$($items.Count)»«str: items"»
«func:Write-Host» «str:"Temp is »«var:$env:TEMP»«str:"»"
`;

exports[`ps1 > tokens > loops 1`] = `
"«kwd:foreach» («var:$file» «kwd:in» «var:$files») {
    «func:Write-Verbose» «var:$file»«oper:.»Name
}

«kwd:for» («var:$i» «oper:=» «num:0»«oper:;» «var:$i» «oper:-lt» «num:10»«oper:;» «var:$i»«oper:++») { «var:$sum» «oper:+=» «var:$i» }

«kwd:while» («bool:$true») { «kwd:break» }

«kwd:do» { «var:$n»«oper:--» } «kwd:until» («var:$n» «oper:-le» «num:0»)"
`;

