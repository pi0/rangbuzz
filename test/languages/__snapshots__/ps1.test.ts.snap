// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ps1 > tokens > booleans 1`] = `
"«bool:$true» «oper:-and» «bool:$false»
«bool:$null» «oper:-eq» «var:$value»"
`;

exports[`ps1 > tokens > classes 1`] = `
"«kwd:class» «class:Widget» «bracket:{»
    «type:[string]»«var:$Name»

    «func:Widget»«bracket:(»«type:[string]»«var:$name»«bracket:)» «bracket:{» «var:$this»«oper:.»Name «oper:=» «var:$name» «bracket:}»

    «type:[string]» «func:Describe»«bracket:(»«bracket:)» «bracket:{» «kwd:return» «str:"widget "» «oper:+» «var:$this»«oper:.»Name «bracket:}»
«bracket:}»

«kwd:enum» «class:Color» «bracket:{» Red«oper:;» Green «bracket:}»"
`;

exports[`ps1 > tokens > cmdlets 1`] = `
"«func:Get-ChildItem» «kwd:-Path» C:\\Logs «kwd:-Filter» «oper:*.»log «kwd:-Recurse» «oper:|»
    «func:Where-Object» «bracket:{» «var:$_»«oper:.»Length «oper:-gt» «num:1MB» «bracket:}» «oper:|»
    «func:Sort-Object» «kwd:-Property» LastWriteTime «kwd:-Descending» «oper:|»
    «func:Select-Object» «kwd:-First» «num:10» «oper:|» «func:Format-Table» Name«oper:,» Length"
`;

exports[`ps1 > tokens > comments 1`] = `
"«cmnt:# a line comment»
«func:Get-Date»  «cmnt:# »«err:TODO»«cmnt:: cache this»
«var:$x» «oper:=» «num:1» «cmnt:# trailing»"
`;

exports[`ps1 > tokens > control flow 1`] = `
"«kwd:if» «bracket:(»«var:$x» «oper:-eq» «num:1»«bracket:)» «bracket:{»
    «func:Write-Output» «str:"one"»
«bracket:}» «kwd:elseif» «bracket:(»«var:$x» «oper:-in» «num:2»«oper:,» «num:3»«bracket:)» «bracket:{»
    «func:Write-Output» «str:"few"»
«bracket:}» «kwd:else» «bracket:{»
    «kwd:switch» «kwd:-Regex» «bracket:(»«var:$x»«bracket:)» «bracket:{»
        «str:'^[0-9]+$'» «bracket:{» «kwd:break» «bracket:}»
        «kwd:default» «bracket:{» «kwd:continue» «bracket:}»
    «bracket:}»
«bracket:}»"
`;

exports[`ps1 > tokens > functions 1`] = `
"«kwd:function» «func:Get-Widget» «bracket:{»
    «bracket:[»«func:CmdletBinding»«bracket:(»«bracket:)»«bracket:]»
    «kwd:param»«bracket:(»
        «bracket:[»«func:Parameter»«bracket:(»Mandatory«bracket:)»«bracket:]»
        «type:[string]»«var:$Name»«oper:,»

        «bracket:[»«func:ValidateRange»«bracket:(»«num:1»«oper:,» «num:10»«bracket:)»«bracket:]»
        «type:[int]»«var:$Count» «oper:=» «num:1»
    «bracket:)»

    «kwd:begin» «bracket:{» «var:$total» «oper:=» «num:0» «bracket:}»
    «kwd:process» «bracket:{» «num:1»«oper:..»«var:$Count» «oper:|» «func:ForEach-Object» «bracket:{» «str:"»«var:$Name»«str:-»«var:$_»«str:"» «bracket:}» «bracket:}»
    «kwd:end» «bracket:{» «var:$total» «bracket:}»
«bracket:}»"
`;

