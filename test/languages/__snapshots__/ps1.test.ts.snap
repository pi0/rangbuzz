exports[`ps1 > tokens > try catch 1`] = `
"«kwd:try» {
    «var:$data» «oper:=» «func:Invoke-RestMethod» «kwd:-Uri» «var:$url» «kwd:-ErrorAction» Stop
} «kwd:catch» «type:[System.Net.WebException]» {
