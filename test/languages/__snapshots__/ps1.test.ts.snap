// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ps1 > tokens > booleans 1`] = `
"«bool:$true» «oper:-and» «bool:$false»
«bool:$null» «oper:-eq» «var:$value»"
`;

exports[`ps1 > tokens > classes 1`] = `
"«kwd:class» «class:Widget» {
    «type:[string]»«var:$Name»

    «func:Widget»(«type:[string]»«var:$name») { «var:$this»«oper:.»Name «oper:=» «var:$name» }

    «type:[string]» «func:Describe»() { «kwd:return» «str:"widget "» «oper:+» «var:$this»«oper:.»Name }
}

«kwd:enum» «class:Color» { Red«oper:;» Green }"
`;

exports[`ps1 > tokens > cmdlets 1`] = `
"«func:Get-ChildItem» «kwd:-Path» C:\\Logs «kwd:-Filter» «oper:*.»log «kwd:-Recurse» «oper:|»
    «func:Where-Object» { «var:$_»«oper:.»Length «oper:-gt» «num:1MB» } «oper:|»
    «func:Sort-Object» «kwd:-Property» LastWriteTime «kwd:-Descending» «oper:|»
    «func:Select-Object» «kwd:-First» «num:10» «oper:|» «func:Format-Table» Name«oper:,» Length"
`;

exports[`ps1 > tokens > comments 1`] = `
"«cmnt:# a line comment»
«func:Get-Date»  «cmnt:# »«err:TODO»«cmnt:: cache this»
«var:$x» «oper:=» «num:1» «cmnt:# trailing»"
`;

exports[`ps1 > tokens > control flow 1`] = `
"«kwd:if» («var:$x» «oper:-eq» «num:1») {
    «func:Write-Output» «str:"one"»
} «kwd:elseif» («var:$x» «oper:-in» «num:2»«oper:,» «num:3») {
    «func:Write-Output» «str:"few"»
} «kwd:else» {
    «kwd:switch» «kwd:-Regex» («var:$x») {
        «str:'^[0-9]+$'» { «kwd:break» }
        «kwd:default» { «kwd:continue» }
    }
}"
`;

exports[`ps1 > tokens > functions 1`] = `
"«kwd:function» «func:Get-Widget» {
    [«func:CmdletBinding»()]
    «kwd:param»(
        [«func:Parameter»(Mandatory)]
        «type:[string]»«var:$Name»«oper:,»

        [«func:ValidateRange»(«num:1»«oper:,» «num:10»)]
        «type:[int]»«var:$Count» «oper:=» «num:1»
    )

    «kwd:begin» { «var:$total» «oper:=» «num:0» }
    «kwd:process» { «num:1»«oper:..»«var:$Count» «oper:|» «func:ForEach-Object» { «str:"»«var:$Name»«str:-»«var:$_»«str:"» } }
    «kwd:end» { «var:$total» }
}"
`;

exports[`ps1 > tokens > help 1`] = `
"«cmnt:<#
.»«kwd:SYNOPSIS»«cmnt:
    Gets a widget.
.»«kwd:DESCRIPTION»«cmnt:
    A longer description.
.»«kwd:PARAMETER»«cmnt: Name
    The widget name.
.»«kwd:EXAMPLE»«cmnt:
    Get-Widget -Name box
#>»
«kwd:function» «func:Get-Widget» { }"
`;

