exports[`pl > tokens > functions 1`] = `
"«kwd:print» «func:join»(«str:","»«oper:,» sort keys «oper:%»h);
«func:push»(@a«oper:,» «num:1»);"
`;

exports[`pl > tokens > keywords 1`] = `
"«kwd:use» strict;
«kwd:my» @list «oper:=» («num:1»«oper:,» «num:2»);
«kwd:foreach» «kwd:my» $«func:i» (@list) {
  «kwd:next» «kwd:if» $i;
  «kwd:last» «kwd:unless» $i;
}
«kwd:sub» f { «kwd:return» «num:1» }"
`;

