exports[`bf > tokens > program 1`] = `"«oper:++++++++»[«kwd:>»«oper:++++»[«kwd:>»«oper:++»«kwd:>»«oper:+++»«kwd:<<»«oper:-»]«kwd:>»«oper:+»«kwd:>>»«oper:+»«kwd:<<<»«oper:-»]«kwd:>>»«func:.»"`;
