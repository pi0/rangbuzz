exports[`bf > tokens > comments 1`] = `
"«oper:+» «cmnt:this text is a comment in brainfuck»
«oper:-»"
`;

exports[`bf > tokens > loops 1`] = `"«oper:+»[«oper:-»«kwd:>»«oper:+»«kwd:<»]"`;

